---
import '@fontsource-variable/figtree';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  locale: 'fr' | 'en';
  title: string;
  description: string;
  /** Path of this page, e.g. "/" or "/en/". */
  path: string;
  /** Path of the same page in the other language (hreflang alternate). */
  alternatePath?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object;
}

const { locale, title, description, path, alternatePath, ogImage, noindex, jsonLd } = Astro.props;

const site = (import.meta.env.SITE ?? 'https://fabosteo77.github.io').replace(/\/$/, '');
const canonical = site + path;
const alternate = alternatePath !== undefined ? site + alternatePath : undefined;
const otherLocale = locale === 'fr' ? 'en' : 'fr';
// Custom OG image per page if set in the CMS, otherwise the branded default card.
const ogImageUrl = site + (ogImage || '/og-image.jpg');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={otherLocale} href={alternate} />}
    {alternate && <link rel="alternate" hreflang={locale} href={canonical} />}
    {alternate && <link rel="alternate" hreflang="x-default" href={locale === 'fr' ? canonical : alternate} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {locale === 'fr' ? 'Aller au contenu' : 'Skip to content'}
    </a>
    <slot />
    <script>
      // Scroll-reveal: fade & rise sections and cards as they enter the viewport.
      // Driven with inline styles so nothing in the cascade can override it, and so
      // the styles can be cleared afterwards (leaving cards their own hover transition).
      // No JS or reduced motion => nothing is ever hidden.
      (() => {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const singles = document.querySelectorAll(
          'main section:not(#top) .wrap > h2, main section:not(#top) .wrap > .section-bar, ' +
          'main section:not(#top) .wrap > p, main section:not(#top) .wrap > .row'
        );
        const groups = document.querySelectorAll('.grid, .about-grid, .contact-grid');

        const targets: { el: HTMLElement; delay: number }[] = [];
        singles.forEach((el) => targets.push({ el: el as HTMLElement, delay: 0 }));
        groups.forEach((group) => {
          [...group.children].forEach((child, i) =>
            targets.push({ el: child as HTMLElement, delay: Math.min(i * 90, 360) })
          );
        });

        // Hide with no transition, so the element never fades *out* first.
        const hide = (el: HTMLElement) => {
          el.style.transition = 'none';
          el.style.opacity = '0';
          el.style.transform = 'translateY(18px)';
        };
        const show = (el: HTMLElement, delay: number) => {
          el.style.transition = `opacity .55s ease ${delay}ms, transform .55s ease ${delay}ms`;
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
          // Clear the inline styles once the reveal has played, so hover effects
          // (card lift + shadow) use their own, faster transition again.
          setTimeout(() => {
            el.style.removeProperty('opacity');
            el.style.removeProperty('transform');
            el.style.removeProperty('transition');
          }, 600 + delay);
        };

        const delays = new WeakMap<Element, number>();
        let observerAlive = false;
        const io = new IntersectionObserver(
          (entries) => {
            observerAlive = true;
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              io.unobserve(el);
              show(el, delays.get(el) ?? 0);
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );

        for (const { el, delay } of targets) {
          delays.set(el, delay);
          hide(el);
        }
        // Paint the hidden state before observing, so the reveal always animates in.
        requestAnimationFrame(() => targets.forEach(({ el }) => io.observe(el)));

        // Safety net: the observer normally reports back as soon as it starts. If it
        // never does (unsupported/blocked environment), reveal everything rather than
        // leave the page hidden — content visibility must never depend on the effect.
        setTimeout(() => {
          if (observerAlive) return;
          io.disconnect();
          targets.forEach(({ el }) => show(el, 0));
        }, 1200);
      })();
    </script>
  </body>
</html>
