---
// Internal control page (gate 3): renders the tokens & primitives so the build
// can be diffed against design/styleguide.html. Not in the menu, noindex.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const colors = [
  ['blue-deep', '#0B54E0', 'white 6.2:1 ✓'],
  ['blue', '#0F62FF', 'accents / links'],
  ['blue-900', '#082E7A', 'footer'],
  ['cyan', '#3FE5FA', 'accent, no text'],
  ['canvas', '#EAF6FD', 'light bg'],
  ['surface', '#FFFFFF', 'cards'],
  ['ink', '#0C1B33', 'text 15:1 ✓'],
  ['ink-muted', '#45566E', '6.8:1 ✓'],
];
---

<Base
  locale="fr"
  title="Styleguide — contrôle interne"
  description="Rendu des jetons de design (contrôle interne)."
  path="/styleguide/"
  noindex={true}
>
  <main id="main">
    <section class="bg-blue on-blue">
      <div class="wrap">
        <div class="accent-bar" style="width:64px;margin-bottom:28px"></div>
        <p class="badge" style="margin-bottom:22px"><span class="stars">★★★★★</span><span>5 stars · 10 Google reviews</span></p>
        <h1>Retrouvez votre mouvement</h1>
        <p class="lead muted" style="margin:20px 0 30px;max-width:30ch">Une approche douce et personnalisée, adaptée pour tous les âges.</p>
        <div class="row">
          <a class="btn btn-lg btn-primary" href="#"><Icon name="calendar" /><span>Prendre rendez-vous</span></a>
          <a class="btn btn-lg btn-ghost" href="#"><Icon name="phone" />06 98 69 48 59</a>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <p class="eyebrow" style="text-transform:uppercase;font-size:12px;letter-spacing:.06em;color:var(--ink-muted)">Couleurs</p>
        <div class="swgrid">
          {colors.map(([name, hex, note]) => (
            <div class="sw">
              <div class="chip" style={`background:${hex}`}></div>
              <div class="meta"><b>{name}</b><br /><span class="hex">{hex} · {note}</span></div>
            </div>
          ))}
        </div>
        <div class="accent-bar" style="margin-top:24px"></div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <p class="eyebrow" style="text-transform:uppercase;font-size:12px;letter-spacing:.06em;color:var(--ink-muted)">Typographie — Figtree</p>
        <div class="type-row"><span class="tag">display-xl</span><span style="font:var(--t-display-xl);letter-spacing:-1.5px">Retrouvez votre mouvement</span></div>
        <div class="type-row"><span class="tag">display-lg</span><span style="font:var(--t-display-lg);letter-spacing:-1px">Pour qui ?</span></div>
        <div class="type-row"><span class="tag">headline</span><span style="font:var(--t-headline)">Mes domaines d'expertise</span></div>
        <div class="type-row"><span class="tag">card-title</span><span style="font:var(--t-card-title)">Adultes et seniors</span></div>
        <div class="type-row"><span class="tag">subhead</span><span style="font:var(--t-subhead);color:var(--ink-muted)">Une approche douce et personnalisée.</span></div>
        <div class="type-row"><span class="tag">body</span><span style="font:var(--t-body)">Fort de près de 20 ans de pratique.</span></div>
        <div class="type-row"><span class="tag">button</span><span style="font:var(--t-button)">Prendre rendez-vous</span></div>
      </div>
    </section>

    <section class="bg-blue on-blue">
      <div class="wrap">
        <p class="eyebrow">Cartes sur fond bleu</p>
        <div class="grid g3">
          <div class="card">
            <div class="chip-icon"><Icon name="activity" /></div>
            <h3>Adultes et seniors</h3>
            <div class="divider"></div>
            <ul class="clean"><li>Douleurs articulaires</li><li>Névralgies</li></ul>
          </div>
          <div class="card">
            <div class="chip-icon"><Icon name="heart" /></div>
            <h3>Femmes enceintes</h3>
            <div class="divider"></div>
            <ul class="clean"><li>Préparation à l'accouchement</li></ul>
          </div>
          <div class="card">
            <div class="chip-icon"><Icon name="baby" /></div>
            <h3>Nourrissons et enfants</h3>
            <div class="divider"></div>
            <ul class="clean"><li>Troubles digestifs</li></ul>
          </div>
        </div>
        <div class="row" style="margin-top:30px">
          <a class="btn btn-primary" href="#"><span>Prendre rendez-vous</span></a>
          <a class="btn btn-secondary" href="#">Voir les cabinets</a>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <p class="eyebrow" style="text-transform:uppercase;font-size:12px;letter-spacing:.06em;color:var(--ink-muted)">Formulaire</p>
        <div class="form-card" style="max-width:560px">
          <div class="form-grid">
            <div class="field"><label for="sg-a">Prénom <span class="req">*</span></label><input class="input" id="sg-a" type="text" placeholder="Votre prénom" /></div>
            <div class="field"><label for="sg-b">Nom <span class="req">*</span></label><input class="input" id="sg-b" type="text" placeholder="Votre nom" /></div>
            <div class="field field-full"><label for="sg-c">Votre message <span class="req">*</span></label><textarea class="input" id="sg-c"></textarea></div>
          </div>
          <div class="notice notice-success" style="margin-top:16px"><Icon name="check-circle" /><span>Merci ! Votre message a bien été envoyé.</span></div>
          <div class="notice notice-error" style="margin-top:10px"><Icon name="alert-circle" /><span>Désolé, l'envoi a échoué.</span></div>
          <button class="btn btn-lg btn-primary" style="margin-top:18px" type="button"><span>Envoyer</span><Icon name="send" /></button>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .swgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  @media (max-width: 820px) { .swgrid { grid-template-columns: 1fr 1fr; } }
  .sw { border-radius: 12px; overflow: hidden; border: 1px solid var(--hairline); background: #fff; }
  .sw .chip { height: 74px; }
  .sw .meta { padding: 10px 12px; font-size: 13px; }
  .sw .meta b { font-weight: 600; font-size: 14px; }
  .sw .meta .hex { color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .type-row { display: flex; align-items: baseline; gap: 18px; padding: 12px 0; border-bottom: 1px solid var(--hairline); }
  .type-row .tag { font-size: 12px; color: var(--ink-muted); width: 120px; flex: none; }
</style>
