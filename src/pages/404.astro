---
import Base from '../layouts/Base.astro';
---

<Base
  locale="fr"
  title="Page introuvable — Fabien Marié, Ostéopathe D.O"
  description="Cette page n'existe pas ou a été déplacée."
  path="/404"
  noindex={true}
>
  <main id="main" class="nf bg-blue on-blue">
    <div class="wrap nf-inner">
      <div class="accent-bar" style="width:64px;margin:0 auto 26px"></div>
      <h1>Page introuvable</h1>
      <p class="lead muted">Cette page n'existe pas ou a été déplacée.</p>
      <p class="lead muted en">This page does not exist or has been moved.</p>
      <div class="row nf-ctas">
        <a class="btn btn-lg btn-primary" href="/"><span>Retour à l'accueil</span></a>
        <a class="btn btn-lg btn-secondary" href="/en/">Back to the home page</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .nf { min-height: 100vh; display: flex; align-items: center; }
  .nf-inner { text-align: center; padding: 64px 0; }
  h1 { margin-bottom: 14px; }
  .en { margin-top: 6px; font-size: 17px; }
  .nf-ctas { justify-content: center; margin-top: 32px; }
</style>
