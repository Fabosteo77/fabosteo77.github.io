---
import Icon from './Icon.astro';

interface Props {
  contact: {
    heading?: string | null;
    subheading?: string | null;
    byPhoneLabel?: string | null;
    socialLabel?: string | null;
    form?: Record<string, string | null | undefined> | null;
  };
  settings: {
    phone: string;
    formRecipient: string;
    socials?: Record<string, string | null | undefined> | null;
  };
  clinicNames: string[];
}
const { contact, settings, clinicNames } = Astro.props;
const form = contact.form ?? {};
const phoneHref = 'tel:+33' + settings.phone.replace(/\s/g, '').replace(/^0/, '');
const SOCIAL_NAMES = ['instagram', 'tiktok', 'facebook', 'linkedin', 'youtube'];
const socialEntries = Object.entries(settings.socials ?? {}).filter(
  ([name, url]) => SOCIAL_NAMES.includes(name) && typeof url === 'string' && url.trim() !== ''
) as [string, string][];
const action = `https://formsubmit.co/${settings.formRecipient}`;
const ajax = `https://formsubmit.co/ajax/${settings.formRecipient}`;
---

<section id="contact">
  <div class="wrap">
    <div class="contact-grid">
      <div>
        <h2 class="heading-blue">{contact.heading}</h2>
        {contact.subheading && <p class="lead muted sub">{contact.subheading}</p>}
        {contact.byPhoneLabel && <p class="label-line">{contact.byPhoneLabel}</p>}
        <a class="btn btn-secondary phone-btn" href={phoneHref}><Icon name="phone" />{settings.phone}</a>
        {socialEntries.length > 0 && (
          <>
            <p class="label-line">{contact.socialLabel}</p>
            <div class="social-chips">
              {socialEntries.map(([name, url]) => (
                <a class="chip-icon" href={url} target="_blank" rel="noopener" aria-label={name}>
                  <Icon name={name} />
                </a>
              ))}
            </div>
          </>
        )}
      </div>
      <form class="form-card" method="POST" action={action} data-ajax={ajax} novalidate>
        <input type="hidden" name="_subject" value={form.heading ?? 'Message'} />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" class="honey" tabindex="-1" aria-hidden="true" autocomplete="off" />
        <div class="form-grid">
          <div class="field">
            <label for="f-prenom">{form.firstNameLabel} <span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="f-prenom" name="prenom" type="text" required autocomplete="given-name" />
          </div>
          <div class="field">
            <label for="f-nom">{form.lastNameLabel} <span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="f-nom" name="nom" type="text" required autocomplete="family-name" />
          </div>
          <div class="field">
            <label for="f-email">{form.emailLabel} <span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="f-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="f-tel">{form.phoneLabel}</label>
            <input class="input" id="f-tel" name="telephone" type="tel" autocomplete="tel" />
          </div>
          <div class="field field-full">
            <label for="f-sujet">{form.subjectLabel} <span class="req" aria-hidden="true">*</span></label>
            <input class="input" id="f-sujet" name="sujet" type="text" required />
          </div>
          <div class="field field-full">
            <label for="f-cabinet">{form.clinicQuestion} <span class="req" aria-hidden="true">*</span></label>
            <select class="input" id="f-cabinet" name="cabinet" required>
              {clinicNames.map((name) => <option value={name}>{name}</option>)}
            </select>
          </div>
          <fieldset class="field field-full">
            <legend>{form.prefQuestion} <span class="req" aria-hidden="true">*</span></legend>
            <div class="radio-row">
              <label><input type="radio" name="recontact" value={form.prefEmail} checked /> {form.prefEmail}</label>
              <label><input type="radio" name="recontact" value={form.prefPhone} /> {form.prefPhone}</label>
            </div>
          </fieldset>
          <div class="field field-full">
            <label for="f-message">{form.messageLabel} <span class="req" aria-hidden="true">*</span></label>
            <textarea class="input" id="f-message" name="message" required></textarea>
          </div>
        </div>
        <div class="notice notice-success form-notice" data-success hidden>
          <Icon name="check-circle" /><span>{form.successMessage}</span>
        </div>
        <div class="notice notice-error form-notice" data-error hidden>
          <Icon name="alert-circle" /><span>{form.errorMessage}</span>
        </div>
        <div aria-live="polite" class="sr-live"></div>
        <button class="btn btn-lg btn-primary submit" type="submit">
          <span>{form.submitLabel}</span>
          <Icon name="send" />
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 40px; align-items: start; }
  @media (max-width: 820px) { .contact-grid { grid-template-columns: 1fr; } }
  .heading-blue { color: var(--blue-deep); }
  .sub { margin: 10px 0 26px; }
  .label-line { font-size: 15px; font-weight: 600; margin-bottom: 10px; }
  .phone-btn { margin-bottom: 26px; }
  .social-chips { display: flex; gap: 12px; flex-wrap: wrap; }
  .social-chips .chip-icon { width: 46px; height: 46px; margin-bottom: 0; border-radius: 12px; }
  .social-chips .chip-icon :global(svg) { width: 22px; height: 22px; }
  .honey { display: none; }
  fieldset { border: 0; }
  legend { font-size: 15px; font-weight: 600; color: var(--ink); margin-bottom: 8px; padding: 0; }
  .form-notice { margin-top: 18px; }
  .submit { margin-top: 20px; }
  .sr-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-ajax]');
  if (form) {
    const success = form.querySelector<HTMLElement>('[data-success]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const live = form.querySelector<HTMLElement>('.sr-live')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      success.hidden = true;
      error.hidden = true;
      submit.disabled = true;
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(form.dataset.ajax!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && (json.success === 'true' || json.success === true)) {
          success.hidden = false;
          live.textContent = success.textContent;
          form.reset();
        } else {
          throw new Error('send failed');
        }
      } catch {
        error.hidden = false;
        live.textContent = error.textContent;
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
