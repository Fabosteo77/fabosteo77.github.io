---
import GoogleG from './GoogleG.astro';
import { initials, avatarColor } from '../lib/avatar';

interface Props {
  about: {
    heading?: string | null;
    paragraphs?: (string | null)[] | null;
    quoteText?: string | null;
    quoteAuthor?: string | null;
    reviewsCtaLabel?: string | null;
  };
  googleReviewsUrl?: string | null;
  reviewsAnchor: string;
}
const { about, googleReviewsUrl, reviewsAnchor } = Astro.props;
const paragraphs = (about.paragraphs ?? []).filter(Boolean);
const reviewsUrl = googleReviewsUrl?.trim() || reviewsAnchor;
---

<section class="about" id="fabien">
  <div class="wrap">
    <div class="about-grid">
      <div>
        <div class="section-bar" aria-hidden="true"></div>
        <h2 class="heading-blue">{about.heading}</h2>
        {paragraphs.map((p) => <p class="body-p">{p}</p>)}
      </div>
      {about.quoteText && (
        <figure class="card quote-card">
          <span class="quote-mark" aria-hidden="true">”</span>
          <div class="quote-top">
            <p class="stars" aria-label="5/5">★★★★★</p>
            <GoogleG class="g-badge" size={22} />
          </div>
          <blockquote>{about.quoteText}</blockquote>
          {about.quoteAuthor && (
            <figcaption class="quote-author">
              <span class="avatar" style={`background:${avatarColor(about.quoteAuthor)}`} aria-hidden="true">{initials(about.quoteAuthor)}</span>
              <span class="qa-name">{about.quoteAuthor}</span>
            </figcaption>
          )}
          {about.reviewsCtaLabel && (
            <a
              class="btn btn-secondary"
              href={reviewsUrl}
              {...(googleReviewsUrl?.trim() ? { target: '_blank', rel: 'noopener' } : {})}
            >{about.reviewsCtaLabel}</a>
          )}
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  .about-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: start; }
  .heading-blue { color: var(--blue-deep); }
  .body-p { margin-top: 18px; max-width: 60ch; }
  .quote-card { position: relative; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; overflow: hidden; }
  .quote-mark {
    position: absolute; top: -18px; right: 6px; z-index: 0;
    font-family: Georgia, 'Times New Roman', serif; font-size: 130px; line-height: 1;
    color: var(--chip-light); pointer-events: none; user-select: none;
  }
  /* Everything except the decorative quote mark, which must stay out of the flow
     (otherwise its 130px glyph opens a large empty gap at the top of the card). */
  .quote-card > *:not(.quote-mark) { position: relative; z-index: 1; }
  .quote-top { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 12px; }
  .quote-card .stars { margin: 0; }
  .quote-card blockquote { font-style: italic; font-size: 16px; }
  .quote-author { display: flex; align-items: center; gap: 10px; }
  .quote-author .avatar {
    width: 38px; height: 38px; flex: none; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 14px; font-weight: 700; letter-spacing: .5px;
  }
  .quote-author .qa-name { font-size: 14px; font-weight: 600; }
  @media (max-width: 820px) { .about-grid { grid-template-columns: 1fr; gap: 32px; } }
  /* Desktop: the hero portrait bleeds into the top of this section, so the whole
     section starts a little lower to clear it. The review card then sits flush with
     the bottom of the text column on the left. */
  @media (min-width: 821px) {
    .about { padding-top: calc(var(--space-section) + 28px); }
    .about-grid > figure { align-self: end; }
  }
</style>
