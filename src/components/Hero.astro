---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { resolveImage } from '../lib/images';

interface Props {
  hero: {
    badge?: string | null;
    heading?: string | null;
    subheading?: string | null;
    ctaLabel?: string | null;
    photo?: string | null;
    photoAlt?: string | null;
    stats?: ({ value?: string | null; label?: string | null } | null)[] | null;
  };
  phone: string;
  bookHref: string;
  reviewsCount?: string | null;
}
const { hero, phone, bookHref } = Astro.props;
const photo = resolveImage(hero.photo);
const phoneHref = 'tel:+33' + phone.replace(/\s/g, '').replace(/^0/, '');
const bookExt = bookHref.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
const stats = (hero.stats ?? []).filter((s) => s?.value);
---

<section class="hero bg-blue on-blue" id="top">
  <div class="wrap">
    <div class="hero-rule" aria-hidden="true"></div>
    <div class="hero-grid">
      <div>
        {hero.badge && (
          <p class="badge">
            <span class="stars" aria-hidden="true">★★★★★</span>
            <span>{hero.badge}</span>
          </p>
        )}
        <h1>{hero.heading}</h1>
        {hero.subheading && <p class="lead muted subhead">{hero.subheading}</p>}
        <div class="row">
          <a class="btn btn-lg btn-primary" href={bookHref} {...bookExt}>
            <Icon name="calendar" />
            <span>{hero.ctaLabel}</span>
          </a>
          <a class="btn btn-lg btn-ghost" href={phoneHref}>
            <Icon name="phone" />
            {phone}
          </a>
        </div>
        {stats.length > 0 && (
          <dl class="stats">
            {stats.map((s) => (
              <div class="stat">
                <dt>{s!.value}</dt>
                <dd>{s!.label}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
      <div class="photo-frame">
        <div class="glow" aria-hidden="true"></div>
        {photo && (
          <Image
            src={photo}
            alt={hero.photoAlt ?? ''}
            widths={[420, 640, 900]}
            sizes="(max-width: 820px) 92vw, 45vw"
            loading="eager"
            fetchpriority="high"
          />
        )}
      </div>
    </div>
  </div>
  <div class="hero-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 64" preserveAspectRatio="none">
      <path d="M0,34 C240,58 480,10 720,26 C960,42 1200,18 1440,38 L1440,64 L0,64 Z" style="fill:var(--canvas)" />
      <path
        d="M0,34 C240,58 480,10 720,26 C960,42 1200,18 1440,38"
        fill="none"
        stroke="var(--cyan)"
        stroke-width="2.5"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  </div>
</section>

<style>
  /* The portrait bleeds over the top padding of the About section (design example). */
  /* Charte: gradient background — text stays on the deep-blue side, cyan behind the portrait. */
  .hero { padding-top: 0; padding-bottom: 0; overflow: visible; background: var(--gradient-hero); }
  /* Ligne de démarcation, dans la page (non collante) : bord supérieur collé à la frontière
     en-tête/héros, du bord du logo au bord du bouton de langue (largeur du contenu). */
  .hero-rule { height: 8px; background: var(--cyan); border-radius: var(--radius-pill); margin: 0 0 88px; }
  @media (max-width: 768px) { .hero-rule { margin: 0 0 52px; } }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: center; }
  /* Texte centré verticalement face à la photo, sans jamais dépasser au-dessus d'elle,
     et aligné au centre horizontalement */
  .hero-grid > div:first-child { align-self: center; text-align: center; }
  .badge { margin-bottom: 22px; }
  .subhead { margin: 20px auto 30px; max-width: 34ch; }
  .row { justify-content: center; }
  .stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 0; margin-top: 38px; }
  .stat { padding: 2px 26px; border-left: 1px solid var(--hairline-blue); }
  .stat:first-child { padding-left: 0; border-left: 0; }
  .stat dt { font-size: 22px; font-weight: 700; color: #fff; letter-spacing: -0.3px; }
  .stat dd { font-size: 13px; font-weight: 500; color: var(--on-blue-muted); margin: 2px 0 0; }
  @media (max-width: 480px) {
    .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 20px; }
    .stat { padding: 0; border-left: 0; }
  }

  .hero-wave { line-height: 0; position: relative; z-index: 1; }
  .hero-wave svg { display: block; width: 100%; height: 56px; }
  @media (max-width: 768px) { .hero-wave svg { height: 36px; } }

  /* Portrait: top aligned with the text, bottom bleeding over the wave into the
     About section below (as in the approved design). */
  .photo-frame { position: relative; z-index: 3; align-self: stretch; margin-bottom: -130px; }
  .glow { position: absolute; inset: -6%; background: var(--gradient); filter: blur(28px); opacity: .5; border-radius: 40px; z-index: 0; animation: glow-drift 14s ease-in-out infinite; transform-origin: center; }
  @keyframes glow-drift {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: .46; }
    33%      { transform: translate(2.5%, -2%) scale(1.05); opacity: .56; }
    66%      { transform: translate(-2%, 2.5%) scale(1.02); opacity: .5; }
  }
  @media (prefers-reduced-motion: reduce) { .glow { animation: none; } }
  .photo-frame img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; object-position: center top; border-radius: var(--radius-photo); display: block; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .hero-grid > div:first-child { padding: 0; }
    /* On phones the portrait sits in the flow, uncropped, with no bleed. */
    .photo-frame { align-self: auto; margin-bottom: 0; padding-bottom: 40px; }
    .photo-frame img { height: auto; object-fit: fill; }
  }
</style>
