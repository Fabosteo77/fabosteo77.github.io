const inner = paths[name] ?? paths['activity'];
const sizeAttrs = size ? `width="${size}" height="${size}"` : '';
const svg = `<svg viewBox="0 0 24 24" ${sizeAttrs} aria-hidden="true" ${className ? `class="${className}"` : ''}>${inner}</svg>`;
---

<Fragment set:html={svg} />
