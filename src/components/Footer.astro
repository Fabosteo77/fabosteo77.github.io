---
import Icon from './Icon.astro';
import logo from '../assets/images/logo.png';

interface Props {
  footer: {
    navLabel?: string | null;
    socialLabel?: string | null;
    contactLabel?: string | null;
    legalLinkText?: string | null;
  };
  header: { links?: ({ label?: string | null; href?: string | null } | null)[] | null };
  settings: {
    phone: string;
    displayEmail: string;
    socials?: Record<string, string | null | undefined> | null;
  };
  locale: 'fr' | 'en';
}
const { footer, header, settings, locale } = Astro.props;
const links = (header.links ?? []).filter((l) => l?.label && l?.href);
const socialEntries = Object.entries(settings.socials ?? {}).filter(
  ([, url]) => typeof url === 'string' && url.trim() !== ''
) as [string, string][];
const phoneHref = 'tel:+33' + settings.phone.replace(/\s/g, '').replace(/^0/, '');
const legalHref = locale === 'fr' ? '/mentions-legales/' : '/en/legal/';
const year = new Date().getFullYear();
---

<footer class="site-footer on-blue">
  <div class="accent-bar" aria-hidden="true"></div>
  <div class="wrap footer-grid">
    <div class="brand-col">
      <img src={logo.src} width={logo.width} height={logo.height} alt="Fabien Marié — Ostéopathe D.O" />
    </div>
    <nav aria-label={footer.navLabel ?? 'Navigation'}>
      <p class="col-title">{footer.navLabel}</p>
      <ul>
        {links.map((l) => <li><a href={l!.href}>{l!.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="col-title">{footer.contactLabel}</p>
      <ul>
        <li><a href={phoneHref}>{settings.phone}</a></li>
        <li><a href={`mailto:${settings.displayEmail}`}>{settings.displayEmail}</a></li>
      </ul>
    </div>
    <div>
      {socialEntries.length > 0 && <p class="col-title">{footer.socialLabel}</p>}
      <div class="social-row">
        {socialEntries.map(([name, url]) => (
          <a href={url} target="_blank" rel="noopener" aria-label={name}><Icon name={name} /></a>
        ))}
      </div>
    </div>
  </div>
  <div class="wrap bottom-line">
    <span>© {year} Fabien Marié — Ostéopathe D.O</span>
    <a href={legalHref}>{footer.legalLinkText}</a>
  </div>
</footer>

<style>
  .site-footer { background: var(--blue-900); color: var(--on-blue); }
  .accent-bar { border-radius: 0; }
  .footer-grid {
    display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px; padding-top: 56px; padding-bottom: 40px;
  }
  .brand-col img { height: 56px; width: auto; }
  .col-title { font-size: 14px; font-weight: 600; color: var(--on-blue-muted); margin-bottom: 12px; }
  ul { list-style: none; }
  li { padding: 4px 0; }
  a { color: #fff; text-decoration: none; font-size: 15px; opacity: .92; }
  a:hover { opacity: 1; text-decoration: underline; }
  .social-row { display: flex; gap: 14px; }
  .social-row a { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; border: 1px solid var(--hairline-blue); border-radius: 12px; }
  .social-row :global(svg) { width: 19px; height: 19px; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .bottom-line {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    border-top: 1px solid var(--hairline-blue);
    padding-top: 20px; padding-bottom: 28px; font-size: 14px;
  }
  .bottom-line a { font-size: 14px; text-decoration: underline; }
  @media (max-width: 820px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
