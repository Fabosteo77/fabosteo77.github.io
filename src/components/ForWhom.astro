---
import Icon from './Icon.astro';

interface Props {
  id: string;
  forWhom: {
    heading?: string | null;
    subheading?: string | null;
    intro?: string | null;
    cards?: ({ icon?: string | null; title?: string | null; items?: (string | null)[] | null } | null)[] | null;
    footnote?: string | null;
    bookCtaLabel?: string | null;
    clinicsCtaLabel?: string | null;
  };
  bookHref: string;
  clinicsAnchor: string;
}
const { id, forWhom, bookHref, clinicsAnchor } = Astro.props;
const cards = (forWhom.cards ?? []).filter(Boolean);
const bookExt = bookHref.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {};
---

<section class="bg-gradient on-blue" id={id}>
  <div class="wrap">
    <div class="section-bar" aria-hidden="true"></div>
    <h2>{forWhom.heading}</h2>
    {forWhom.subheading && <p class="lead muted intro">{forWhom.subheading}</p>}
    {forWhom.intro && <p class="muted intro-2">{forWhom.intro}</p>}
    <div class="grid g3">
      {cards.map((card) => (
        <div class="card">
          <div class="chip-icon"><Icon name={card!.icon ?? 'activity'} /></div>
          <h3>{card!.title}</h3>
          <div class="divider"></div>
          <ul class="clean">
            {(card!.items ?? []).filter(Boolean).map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
    {forWhom.footnote && <p class="footnote">{forWhom.footnote}</p>}
    <div class="row ctas">
      {forWhom.bookCtaLabel && (
        <a class="btn btn-primary" href={bookHref} {...bookExt}><span>{forWhom.bookCtaLabel}</span></a>
      )}
      {forWhom.clinicsCtaLabel && (
        <a class="btn btn-secondary" href={clinicsAnchor}>{forWhom.clinicsCtaLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .intro { max-width: 60ch; margin-bottom: 12px; }
  .intro-2 { max-width: 70ch; margin-bottom: 34px; font-size: 16px; }
  /* Preventive-medicine callout: solid white with a cyan left bar, so it stays
     readable over the cyan end of the gradient. */
  .footnote {
    margin-top: 30px; font-size: 15px; font-weight: 500; color: var(--ink);
    display: inline-block; max-width: 68ch;
    background: var(--surface);
    border-left: 4px solid var(--cyan);
    border-radius: 10px; padding: 14px 18px;
    box-shadow: var(--shadow);
  }
  .ctas { margin-top: 26px; }
</style>
